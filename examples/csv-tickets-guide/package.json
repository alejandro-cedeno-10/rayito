{
  "name": "csv-tickets-guide",
  "version": "0.1.0",
  "private": true,
  "description": "Lab for the tickets CSV guide with Rayito 0.15.0 (TypeScript)",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check ."
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1154.0",
    "rayito": "0.15.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
