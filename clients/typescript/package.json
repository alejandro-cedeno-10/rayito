      "optional": true
    },
    "smol-toml": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1138.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1138.0",
    "@aws-sdk/client-cloudformation": "^3.1138.0",
    "@aws-sdk/client-cloudfront-keyvaluestore": "^3.1138.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1138.0",
    "@aws-sdk/client-codebuild": "^3.1138.0",
    "@aws-sdk/client-cost-explorer": "^3.1138.0",
    "@aws-sdk/client-dynamodb": "^3.1138.0",
    "@aws-sdk/client-ec2": "^3.1138.0",
    "@aws-sdk/client-ecr": "^3.1138.0",
    "@aws-sdk/client-efs": "^3.1138.0",
    "@aws-sdk/client-iam": "^3.1138.0",
    "@aws-sdk/client-secrets-manager": "^3.1138.0",
    "@aws-sdk/client-service-quotas": "^3.1138.0",
    "@aws-sdk/client-ssm": "^3.1138.0",
    "@aws-sdk/signature-v4a": "^3.1138.0",
    "@aws/bedrock-token-generator": "1.1.0",
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^20.19.43",
    "ajv": "8.17.1",
    "aws-cdk-lib": "2.274.0",
    "constructs": "10.8.1",
    "smol-toml": "1.9.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
