      "optional": true
    },
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/client-ec2": {
      "optional": true
    },
    "@aws-sdk/client-ecr": {
      "optional": true
    },
    "@aws-sdk/client-efs": {
      "optional": true
    },
    "@aws-sdk/client-iam": {
      "optional": true
    },
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "@aws-sdk/client-service-quotas": {
      "optional": true
    },
    "@aws-sdk/signature-v4a": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "aws-cdk-lib": {
