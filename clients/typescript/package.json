{
  "name": "rayito",
  "version": "0.16.0",
  "description": "SDK TypeScript de Rayito: sandboxes de ejecución para agentes de IA sobre AWS Lambda MicroVMs, dentro de tu propia cuenta, y despliegue de agentes en MicroVMs o en Amazon Bedrock AgentCore, con la CLI o con CDK.",
  "license": "Apache-2.0",
  "homepage": "https://alejandro-cedeno-10.github.io/rayito/",
  "bugs": {
    "url": "https://github.com/alejandro-cedeno-10/rayito/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alejandro-cedeno-10/rayito.git",
    "directory": "clients/typescript"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "sideEffects": false,
  "bin": {
    "rayito": "./dist/cli.mjs",
    "rayito-mcp": "./dist/mcp.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./e2b": {
      "import": {
        "types": "./dist/e2b.d.mts",
        "default": "./dist/e2b.mjs"
      },
      "require": {
        "types": "./dist/e2b.d.cts",
        "default": "./dist/e2b.cjs"
      }
    },
    "./cdk": {
      "import": {
        "types": "./dist/cdk.d.mts",
        "default": "./dist/cdk.mjs"
      },
      "require": {
        "types": "./dist/cdk.d.cts",
        "default": "./dist/cdk.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown && node scripts/copy-dashboard-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests && pnpm run test:infra-functions",
    "test:e2e": "vitest run --project e2e --no-file-parallelism",
    "test:infra-functions": "node --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"../../infra/functions/tests/cloudfront-runtime-shim.mjs\", pathToFileURL(\"./\"));' --test ../../infra/functions/tests/custom_domain_router.test.mjs",
    "lint": "biome check .",
    "pack:check": "node scripts/pack-check.mjs && node scripts/check-dts-cost-blocks.mjs",
    "format": "biome format --write .",
    "gen": "cd ../.. && buf generate"
  },
  "keywords": [
    "sandbox",
    "aws",
    "lambda",
    "microvm",
    "agents",
    "e2b",
    "code-interpreter",
    "bedrock",
    "agentcore",
    "aws-cdk",
    "cdk",
    "agent-deployment"
  ],
  "dependencies": {
    "@aws-sdk/client-lambda-microvms": "^3.1138.0",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/client-sts": "^3.1138.0",
    "@aws-sdk/lib-storage": "^3.1138.0",
    "@aws-sdk/s3-presigned-post": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@smithy/node-http-handler": "^4.12.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1138.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1138.0",
    "@aws-sdk/client-cloudformation": "^3.1138.0",
    "@aws-sdk/client-cloudfront-keyvaluestore": "^3.1138.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1138.0",
    "@aws-sdk/client-codebuild": "^3.1138.0",
    "@aws-sdk/client-cost-explorer": "^3.1138.0",
    "@aws-sdk/client-dynamodb": "^3.1138.0",
    "@aws-sdk/client-ec2": "^3.1138.0",
    "@aws-sdk/client-ecr": "^3.1138.0",
    "@aws-sdk/client-efs": "^3.1138.0",
    "@aws-sdk/client-iam": "^3.1138.0",
    "@aws-sdk/client-secrets-manager": "^3.1138.0",
    "@aws-sdk/client-service-quotas": "^3.1138.0",
    "@aws-sdk/signature-v4a": "^3.1138.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@opentelemetry/api": "^1.9.0",
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.5.0",
    "smol-toml": "^1.9.0",
    "zod": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-bedrock-agentcore": {
      "optional": true
    },
