{
  "schema": "rayito.agent-project/1",
  "name": "ticket-agent",
  "runtime": {
    "kind": "langgraph",
    "entrypoint": "agent:build_graph"
  },
  "model": {
    "provider": "openai-compatible",
    "gateway": "llm",
    "base_path": "/v1",
    "id_env": "LLM_MODEL",
    "base_url_env": "LLM_BASE_URL",
    "api_key_env": "LLM_API_KEY"
  },
  "gateways": {
    "llm": {
      "preset": "custom",
      "upstream": "https://llm-gateway.example.com",
      "headers": {
        "authorization": "rayito/agents/ticket-agent/llm"
      },
      "allow": [
        [
          "POST",
          "/v1/chat/completions"
        ]
      ]
    }
  }
}
