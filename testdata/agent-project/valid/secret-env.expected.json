{
  "schema": "rayito.agent-project/1",
  "name": "ticket-agent",
  "runtime": {
    "kind": "langgraph",
    "entrypoint": "agent.graph:build"
  },
  "model": {
    "provider": "openai",
    "id": "gpt-5-mini",
    "gateway": "openai"
  },
  "gateways": {
    "openai": {
      "preset": "custom",
      "upstream": "https://api.openai.com",
      "headers": {
        "authorization": "rayito/openai-key"
      },
      "allow": [
        [
          "POST",
          "/v1/responses"
        ],
        [
          "POST",
          "/v1/chat/completions"
        ]
      ]
    }
  },
  "env": {
    "LOG_LEVEL": "info"
  },
  "secret_env": {
    "DATABASE_URL": "app/db-url",
    "LLM_GATEWAY_KEY": {
      "secret": "arn:aws:secretsmanager:us-east-1:123456789012:secret:llm-AbCdEf",
      "key": "api_key",
      "version_stage": "AWSCURRENT"
    }
  },
  "secret_env_from": [
    {
      "secret": "app/config",
      "prefix": "APP_",
      "keys": [
        "DB_HOST",
        "DB_USER"
      ]
    },
    {
      "secret": "app/flags"
    }
  ]
}
