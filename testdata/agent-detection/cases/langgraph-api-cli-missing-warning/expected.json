{
  "schema": "rayito.agent-detection/1",
  "language": "python",
  "framework": "langgraph",
  "kind": "custom",
  "entrypoint": "agent:graph",
  "entrypoint_kind": "object",
  "protocol": "langgraph-api",
  "options": {},
  "app": {
    "framework": "langgraph-json",
    "command": [
      "langgraph",
      "dev",
      "--no-browser",
      "--no-reload",
      "--host",
      "127.0.0.1",
      "--port",
      "8000",
      "--config",
      "langgraph.json"
    ],
    "port": 8000,
    "port_env": null,
    "health_path": "/ok",
    "invoke_path": null,
    "request_field": null,
    "response_field": null,
    "assistant_id": "agent"
  },
  "install": {
    "manager": "pip",
    "lockfile": null,
    "requirements": "requirements.txt",
    "require_hashes": false,
    "reproducible": true,
    "build_script": false,
    "python_version": "3.12",
    "node_version": null
  },
  "providers": [],
  "models": [],
  "evidence": [
    {
      "path": "langgraph.json",
      "rule": "file:langgraph.json"
    },
    {
      "path": "agent.py",
      "rule": "entry:langgraph-json"
    },
    {
      "path": "requirements.txt",
      "rule": "install:pip"
    }
  ],
  "warnings": [
    {
      "code": "langgraph_cli_missing",
      "detail": "langgraph-cli[inmem] no está en tus dependencias: añádelo para usar --protocol langgraph-api"
    },
    {
      "code": "langgraph_dev_server",
      "detail": "langgraph dev es un servidor de desarrollo en memoria (experimental en Rayito)"
    },
    {
      "code": "no_provider",
      "detail": "no se detecta ningún proveedor de modelo; indícalo con --secret proveedor=nombre"
    }
  ],
  "alternatives": []
}
