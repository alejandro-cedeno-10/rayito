{
  "schema": "rayito.agent-project/1",
  "name": "langchain-create-agent",
  "runtime": {
    "kind": "langgraph",
    "entrypoint": "agent:agent",
    "requirements": "uv.lock",
    "package_manager": "uv",
    "language": "python",
    "framework": "langgraph",
    "python_version": "3.12"
  },
  "source": {
    "path": "."
  },
  "model": {
    "provider": "bedrock",
    "id": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
    "gateway": "bedrock",
    "region": "us-east-1"
  },
  "gateways": {
    "bedrock": {
      "preset": "custom",
      "upstream": "https://bedrock-runtime.us-east-1.amazonaws.com",
      "headers": {
        "authorization": "agents/langchain-create-agent/bedrock"
      },
      "allow": [
        [
          "POST",
          "/model/us.anthropic.claude-haiku-4-5-20251001-v1%3A0/converse-stream"
        ],
        [
          "POST",
          "/model/us.anthropic.claude-haiku-4-5-20251001-v1%3A0/converse"
        ]
      ]
    }
  }
}
