{
  "schema": "rayito.agent-project/1",
  "name": "opencode",
  "runtime": {
    "kind": "opencode",
    "framework": "opencode"
  },
  "source": {
    "path": "."
  },
  "model": {
    "provider": "bedrock",
    "id": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
    "gateway": "bedrock",
    "region": "us-east-1"
  },
  "gateways": {
    "bedrock": {
      "preset": "custom",
      "upstream": "https://bedrock-runtime.us-east-1.amazonaws.com",
      "headers": {
        "authorization": "agents/opencode/bedrock"
      },
      "allow": [
        [
          "POST",
          "/model/us.anthropic.claude-haiku-4-5-20251001-v1%3A0/converse-stream"
        ],
        [
          "POST",
          "/model/us.anthropic.claude-haiku-4-5-20251001-v1%3A0/converse"
        ]
      ]
    }
  },
  "agent": {
    "instructions": "# Project rules\n\nYou are a calculator and glossary assistant. Answer every question in one\nshort sentence. When asked to add numbers, add them yourself and state the\nresult. The glossary: a MicroVM is a lightweight virtual machine, and a\nsnapshot is a saved machine state.\n",
    "permissions": {
      "tools": {
        "bash": "deny",
        "edit": "deny",
        "webfetch": "deny"
      }
    }
  }
}
