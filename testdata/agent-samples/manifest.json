      "language": "python",
      "dir": "python/langgraph-fastapi",
      "lockfile": "uv.lock",
      "tools": ["add", "order_status"],
      "toolUse": true,
      "expected": { "framework": "langgraph", "protocol": "framework", "entry": "graph:build_graph" },
      "alternatives": [{ "kind": "http-app", "health": "/health", "invoke": "/chat", "requestField": "message", "responseField": "answer", "protocol": "json" }]
    },
