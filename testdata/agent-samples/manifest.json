{
  "schema": "rayito.agent-samples/1",
  "_comment": "Los quince agentes de ejemplo que despliega la aceptación de 0.14 sin tocar su código. Ninguno importa rayito y cada uno trae su propio lockfile (Hermes y OpenCode son sólo configuración, sin lockfile). `expected` es lo que debe decidir la detección sin opciones (`framework`, `kind` del runtime, protocolo, punto de entrada y gestor de instalación); `httpAlternative` es la app HTTP que la detección lista como alternativa y que `--entry http` sirve; `custom` es la combinación de opciones de la segunda pasada. Lo leen los tests de Python y de TypeScript.",
  "model": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
  "prompt": "What is 17 plus 25? Use the add tool if you have one and reply with the number.",
  "expectedAnswer": "42",
  "custom": {
    "memoryMib": 4096,
    "maxSessions": 2,
    "minVms": 1,
    "maxVms": 2,
    "warmVms": 1
  },
  "samples": [
    {
      "id": "python-langgraph-fastapi",
      "language": "python",
      "dir": "python/langgraph-fastapi",
      "lockfile": "uv.lock",
      "tools": [
        "add",
        "order_status"
      ],
      "toolUse": true,
      "expected": {
        "framework": "langgraph",
        "kind": "langgraph",
        "protocol": "framework",
        "entry": "graph:build_graph",
        "installManager": "uv"
      },
      "httpAlternative": {
        "framework": "fastapi",
        "protocol": "json",
        "health": "/health",
        "invoke": "/chat",
        "requestField": "message",
        "responseField": "answer"
      }
    },
