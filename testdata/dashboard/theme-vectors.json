{
  "description": "Theme and logo vectors shared by the Python and TypeScript SDKs. `valid` themes carry the parsed token sections and the exact generated CSS; `invalid` ones the exact error message, which never repeats the offending value (`messageExcludes`). A theme is `text` or a JSON `document`. Logos are base64 so binary files survive the JSON; sizes over the cap are tested with the named limits in each SDK.",
  "themes": {
    "valid": [
      {
        "id": "an empty theme",
        "format": "json",
        "document": {
          "version": 1
        },
        "expected": {
          "name": "custom",
          "shared": {},
          "dark": {},
          "light": {},
          "css": "/* Tema «custom» (generado) */\n\n"
        }
      },
      {
        "id": "a named theme with dark and light colors",
        "format": "json",
        "document": {
          "version": 1,
          "name": "demo",
          "dark": {
            "bg": "#101010"
          },
          "light": {
            "bg": "#fff"
          }
        },
        "expected": {
          "name": "demo",
          "shared": {},
          "dark": {
            "bg": "#101010"
          },
          "light": {
            "bg": "#fff"
          },
          "css": "/* Tema «demo» (generado) */\n/* dark */\n:root, :root[data-theme=\"dark\"] {\n  --bg: #101010;\n}\n/* light */\n:root[data-theme=\"light\"] {\n  --bg: #fff;\n}\n@media (prefers-color-scheme: light) {\n  :root:not([data-theme=\"dark\"]) {\n    --bg: #fff;\n  }\n}\n"
        }
      },
