{
  "schema": "rayito.agent-deploy-resolve/1",
  "buckets": [
    {
      "name": "the argument wins over everything",
      "explicit": "amzn-s3-demo-bucket",
      "projectFile": "file-bucket",
      "environment": "env-bucket",
      "discovered": "cdk-bucket",
      "expected": {
        "bucket": "amzn-s3-demo-bucket",
        "source": "argument"
      }
    },
    {
      "name": "the project file wins over the environment",
      "explicit": null,
      "projectFile": "file-bucket",
      "environment": "env-bucket",
      "discovered": "cdk-bucket",
      "expected": {
        "bucket": "file-bucket",
        "source": "project_file"
      }
    },
    {
      "name": "the environment wins over discovery",
      "explicit": null,
      "projectFile": null,
      "environment": "env-bucket",
      "discovered": "cdk-bucket",
      "expected": {
        "bucket": "env-bucket",
        "source": "environment"
      }
    },
    {
      "name": "discovery is the last resort",
      "explicit": null,
      "projectFile": null,
      "environment": null,
      "discovered": "cdk-bucket",
      "expected": {
        "bucket": "cdk-bucket",
        "source": "discovered"
      }
    },
    {
      "name": "no bucket anywhere is an error",
      "explicit": null,
      "projectFile": null,
      "environment": null,
      "discovered": null,
      "expected": null
    }
  ],
