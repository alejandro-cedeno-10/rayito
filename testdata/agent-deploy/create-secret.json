{
  "schema": "rayito.agent-deploy-create-secret/1",
  "_comment": "`--create-secret` (`create_secret_from_env` / `createSecretFromEnv`) por el preset de la pasarela y con el nombre exacto que la pasarela lee. `project` es el documento base y cada caso pone su pasarela en `gateways.<gateway>` y `model.gateway`. Los nombres de `existing`, `existsCalls` y `created` son relativos al prefijo `secretPrefix` con el que la pasarela lee el secreto; `awsName` es el nombre completo en Secrets Manager. `gatewaySecret` es el secreto con el que queda la pasarela tras resolver. `detectedSecretTemplate` es el secreto que escribe la detección. Las claves son de prueba.",
  "secretPrefix": "rayito/",
  "detectedSecretTemplate": "agents/{project}/{provider}",
  "project": {
    "schema": "rayito.agent-project/1",
    "name": "my-agent",
    "runtime": {
      "kind": "opencode"
    },
    "model": {
      "provider": "bedrock",
      "id": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
      "region": "us-east-1"
    }
  },
  "cases": [
    {
      "name": "pasarela model con preset bedrock",
      "gateway": "model",
      "table": {
        "preset": "bedrock",
        "secret": "agents/my-agent/model",
        "region": "us-east-1",
        "models": [
          "us.anthropic.claude-haiku-4-5-20251001-v1:0"
        ]
      },
      "existing": [],
      "environment": {
        "AWS_BEARER_TOKEN_BEDROCK": "abskexample"
      },
      "expected": {
        "envVar": "AWS_BEARER_TOKEN_BEDROCK",
        "existsCalls": [
          "agents/my-agent/model",
          "rayito/agents/my-agent/model"
        ],
        "created": "agents/my-agent/model",
        "awsName": "rayito/agents/my-agent/model",
        "value": "Bearer abskexample",
        "gatewaySecret": "agents/my-agent/model"
      }
    },
    {
      "name": "pasarela detectada con el nombre convencional",
      "gateway": "bedrock",
      "table": {
        "preset": "bedrock",
        "secret": "agents/my-agent/bedrock",
        "region": "us-east-1",
        "models": [
          "us.anthropic.claude-haiku-4-5-20251001-v1:0"
        ]
      },
      "existing": [],
      "environment": {
        "AWS_BEARER_TOKEN_BEDROCK": "abskexample"
      },
      "expected": {
        "envVar": "AWS_BEARER_TOKEN_BEDROCK",
        "existsCalls": [
          "agents/my-agent/bedrock",
          "rayito/agents/my-agent/bedrock"
        ],
        "created": "agents/my-agent/bedrock",
        "awsName": "rayito/agents/my-agent/bedrock",
        "value": "Bearer abskexample",
        "gatewaySecret": "agents/my-agent/bedrock"
      }
    },
    {
      "name": "el secreto que creó 0.16 con el prefijo duplicado se reutiliza",
      "gateway": "bedrock",
      "table": {
        "preset": "bedrock",
        "secret": "agents/my-agent/bedrock",
        "region": "us-east-1",
        "models": [
          "us.anthropic.claude-haiku-4-5-20251001-v1:0"
        ]
      },
      "existing": [
        "rayito/agents/my-agent/bedrock"
      ],
      "environment": {
        "AWS_BEARER_TOKEN_BEDROCK": "abskexample"
      },
      "expected": {
        "envVar": "AWS_BEARER_TOKEN_BEDROCK",
        "existsCalls": [
          "agents/my-agent/bedrock",
          "rayito/agents/my-agent/bedrock"
        ],
        "created": null,
        "awsName": "rayito/rayito/agents/my-agent/bedrock",
        "value": null,
        "gatewaySecret": "rayito/agents/my-agent/bedrock"
      }
    },
    {
      "name": "un nombre propio nunca se reinterpreta",
      "gateway": "model",
      "table": {
        "preset": "bedrock",
        "secret": "team/llm",
        "region": "us-east-1",
        "models": [
          "us.anthropic.claude-haiku-4-5-20251001-v1:0"
        ]
      },
      "existing": [],
      "environment": {
        "AWS_BEARER_TOKEN_BEDROCK": "abskexample"
      },
      "expected": {
        "envVar": "AWS_BEARER_TOKEN_BEDROCK",
        "existsCalls": [
          "team/llm"
        ],
        "created": "team/llm",
        "awsName": "rayito/team/llm",
        "value": "Bearer abskexample",
        "gatewaySecret": "team/llm"
      }
    },
    {
      "name": "preset custom: la variable sale del nombre de la pasarela, como en 0.16",
      "gateway": "openai",
      "table": {
        "preset": "custom",
        "upstream": "https://api.openai.com",
        "headers": {
          "authorization": "agents/my-agent/openai"
        },
        "allow": [
          [
            "POST",
            "/v1/responses"
          ]
        ]
      },
      "existing": [],
      "environment": {
        "OPENAI_API_KEY": "valor-de-prueba"
      },
      "expected": {
        "envVar": "OPENAI_API_KEY",
        "existsCalls": [
          "agents/my-agent/openai",
          "rayito/agents/my-agent/openai"
        ],
        "created": "agents/my-agent/openai",
        "awsName": "rayito/agents/my-agent/openai",
        "value": "Bearer valor-de-prueba",
        "gatewaySecret": "agents/my-agent/openai"
      }
    },
    {
      "name": "sin la variable del preset falla nombrándola",
      "gateway": "model",
      "table": {
        "preset": "bedrock",
        "secret": "agents/my-agent/model",
        "region": "us-east-1",
        "models": [
          "us.anthropic.claude-haiku-4-5-20251001-v1:0"
        ]
      },
      "existing": [],
      "environment": {},
      "expected": {
        "envVar": "AWS_BEARER_TOKEN_BEDROCK",
        "existsCalls": [
          "agents/my-agent/model",
          "rayito/agents/my-agent/model"
        ],
        "error": "no se puede crear el secreto de la pasarela 'model': la variable AWS_BEARER_TOKEN_BEDROCK no está definida"
      }
    }
  ]
}
