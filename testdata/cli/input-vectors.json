{
  "description": "Vectores de entrada de la CLI compartidos por Python y TypeScript (ADR-027): `shlex.join`, pares K=V y `--since`.",
  "shellJoin": [
    {
      "words": [
        "ls"
      ],
      "expected": "ls"
    },
    {
      "words": [
        "ls",
        "-l",
        "/tmp"
      ],
      "expected": "ls -l /tmp"
    },
    {
      "words": [
        "echo",
        "hello world"
      ],
      "expected": "echo 'hello world'"
    },
    {
      "words": [
        "echo",
        "it's"
      ],
      "expected": "echo 'it'\"'\"'s'"
    },
    {
      "words": [
        "sh",
        "-c",
        "a && b; c | d"
      ],
      "expected": "sh -c 'a && b; c | d'"
    },
    {
      "words": [
        ""
      ],
      "expected": "''"
    },
    {
      "words": [
        "a_b-c.d/e:f=g,h@i%j+k"
      ],
      "expected": "a_b-c.d/e:f=g,h@i%j+k"
    },
    {
      "words": [
        "$HOME",
        "`x`",
        "\"q\""
      ],
      "expected": "'$HOME' '`x`' '\"q\"'"
    },
    {
      "words": [
        "ñ",
        "tab\tx",
        "new\nline"
      ],
      "expected": "'ñ' 'tab\tx' 'new\nline'"
    }
  ],
  "pairs": [
    {
      "values": [],
      "expected": {}
    },
    {
      "values": [
        "A=1"
      ],
      "expected": {
        "A": "1"
      }
    },
    {
      "values": [
        "A=1",
        "B=x=y"
      ],
      "expected": {
        "A": "1",
        "B": "x=y"
      }
    },
    {
      "values": [
        "EMPTY="
      ],
      "expected": {
        "EMPTY": ""
      }
    },
    {
      "values": [
        "A=1",
        "A=2"
      ],
      "expected": {
        "A": "2"
      }
    }
  ],
  "pairErrors": [
