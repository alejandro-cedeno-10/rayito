  "errors": {
    "A": [
      {
        "exception": "AgentProjectException",
        "code": "missing_key",
        "path": "model.id",
        "when": "runtime builds the model or preset in modelIdRequiredPresets (file)"
      },
      {
        "exception": "AgentProjectException",
        "code": "not_detected",
        "path": "model.id",
        "when": "unchanged: detection with a preset in modelIdRequiredPresets"
      },
      {
        "exception": "AgentProjectException",
        "code": "invalid_value",
        "path": "model.provider",
        "when": "--model-provider names no preset"
      },
      {
        "exception": "AgentProjectException",
        "code": "conflict",
        "path": "model.base_url_env",
        "when": "the same name is also in [env]"
      },
      {
        "exception": "AgentCoreException",
        "code": "model_required",
        "when": "agentcore + bedrock + no model.id + no bedrock_models (now raised; message and exit code unchanged)"
      }
    ],
    "B": [
      {
        "exception": "AgentProjectException",
        "code": "ambiguous",
        "path": "runtime.entrypoint",
        "messageKey": "ambiguous_graph"
      },
      {
        "exception": "AgentProjectException",
        "code": "invalid_value",
        "path": "runtime.graph",
        "messageKey": "graph_not_found"
      },
      {
        "exception": "AgentProjectException",
        "code": "conflict",
        "path": "runtime.graph",
        "messageKey": "graph_conflict"
      },
      {
        "exception": "AgentProjectException",
        "code": "invalid_value",
        "path": "runtime.graph",
        "when": "graph on a kind other than langgraph"
      },
      {
        "exception": "AgentException",
        "reason": "protocol_error",
        "detailCodes": [
          "input_required",
          "invalid_input",
          "output_not_serializable"
        ]
      },
      {
        "exception": "InvalidArgumentException",
        "messageKeys": [
          "prompt_or_input",
          "input_not_object",
          "input_too_large",
          "host_too_old"
        ]
      }
    ],
    "C": [
      {
        "exception": "AgentProjectException",
        "codes": [
          "invalid_value",
          "conflict",
          "secret_value",
          "unknown_key"
        ],
        "paths": [
          "secret_env.<NAME>",
          "secret_env_from[<i>]"
        ]
      },
      {
        "exception": "AgentException",
        "reason": "runtime_error",
        "detailCodes": [
          "secret_env_unavailable",
          "secret_env_denied",
          "secret_env_invalid",
          "secret_env_invalid_key",
          "secret_env_reserved"
        ],
        "when": "host startup (fail closed)"
      },
      {
        "exception": "AgentCoreException",
        "code": "env_invalid",
        "when": "RAYITO_SECRET_ENV longer than agentcoreEnvironmentValueMaxChars (existing code)"
      }
    ],
    "D": [
      {
        "exception": "AgentException",
        "reason": "protocol_error",
        "detailCodes": [
          "graph_interrupted"
        ]
      },
      {
        "exception": "AgentProjectException",
        "code": "invalid_value",
        "path": "runtime.app.protocol",
        "messageKey": "langgraph_api_without_langgraph_json"
      },
      {
        "exception": "InvalidArgumentException",
        "when": "assistant_id missing with langgraph-api, or set with another protocol"
      }
    ]
  },
  "agentDetectionRules": [
    {
      "feature": "A",
      "section": "(top level)",
      "key": "modelFromCode",
      "after": "maxModelsListed"
    },
    {
      "feature": "A",
      "section": "messages",
      "key": "invalid_model_provider",
      "after": "invalid_override",
      "text": "--model-provider {value} no es una pasarela conocida ({candidates})"
    },
    {
      "feature": "A",
      "section": "warnings",
      "key": "model_id_from_code",
      "after": "no_provider",
      "text": "no se fija el id del modelo: lo elige tu código ({envs})"
    },
    {
      "feature": "B",
      "section": "messages",
      "key": "ambiguous_graph",
      "after": "ambiguous_entrypoint",
      "text": "langgraph.json tiene varios grafos ({candidates}); elige uno con --graph o [runtime] graph"
    },
    {
      "feature": "B",
      "section": "messages",
      "key": "graph_not_found",
      "after": "not_detected_entrypoint",
      "text": "langgraph.json no tiene el grafo {value} ({candidates})"
    },
    {
      "feature": "B",
      "section": "messages",
      "key": "graph_conflict",
      "after": "graph_not_found",
      "text": "usa --graph o --entry, no los dos"
    },
    {
      "feature": "C",
      "section": "warnings",
      "key": "env_missing",
      "after": "file_unreadable",
      "text": "{name} está en .env.example pero no recibe valor ([env], --secret-env o --secret-env-from)"
    },
    {
      "feature": "D",
      "section": "app.launchers",
      "key": "langgraph-dev",
      "after": "flask",
      "value": {
        "command": [
          "langgraph",
          "dev",
          "--no-browser",
          "--no-reload",
          "--host",
          "127.0.0.1",
          "--port",
          "{port}",
          "--config",
          "langgraph.json"
        ],
        "portLiteral": false
      }
    },
    {
      "feature": "D",
      "section": "messages",
      "key": "langgraph_api_without_langgraph_json",
      "after": "unsupported_port",
      "text": "--protocol langgraph-api necesita un langgraph.json en el proyecto"
    },
    {
      "feature": "D",
      "section": "warnings",
      "key": "langgraph_cli_missing",
      "after": "protocol_ignored",
      "text": "langgraph-cli[inmem] no está en tus dependencias: añádelo para usar --protocol langgraph-api"
    },
    {
      "feature": "D",
      "section": "warnings",
      "key": "langgraph_dev_server",
      "after": "langgraph_cli_missing",
      "text": "langgraph dev es un servidor de desarrollo en memoria (experimental en Rayito)"
    }
  ],
  "limits": [
    {
      "feature": "B",
      "key": "agentServiceMaxOutputBytes",
      "value": 1048576,
      "after": "agentServiceMaxRequestBytes",
      "source": "igual que agentServiceMaxRequestBytes; muy por debajo de los 100 MB de carga de AgentCore"
    },
    {
      "feature": "C",
      "key": "agentSecretEnvVariable",
      "value": "RAYITO_SECRET_ENV",
      "after": "agentSecretNameTemplate"
    },
    {
      "feature": "C",
      "key": "agentSecretEnvSpecVersion",
      "value": 1,
      "after": "agentSecretEnvVariable"
    },
    {
      "feature": "C",
      "key": "agentSecretEnvMaxSecrets",
      "value": 20,
      "after": "agentSecretEnvSpecVersion",
      "source": "una llamada GetSecretValue por secreto y sesión; tope de diseño"
    },
    {
      "feature": "C",
      "key": "agentSecretEnvMaxTotalBytes",
      "value": 262144,
      "after": "agentSecretEnvMaxSecrets",
      "source": "cuatro secretos del tamaño máximo de Secrets Manager (65536 bytes)"
    },
    {
      "feature": "C",
      "key": "agentSecretEnvHelperTimeoutSeconds",
      "value": 15,
      "after": "agentSecretEnvMaxTotalBytes",
      "source": "provisional; se mide en la aceptación (AWS_API_NOTES Q188)"
    },
    {
      "feature": "C",
      "key": "agentSecretEnvReservedNames",
      "value": [
        "HOME",
        "NODE_OPTIONS",
        "PATH",
        "PYTHONPATH"
      ],
      "after": "agentSecretEnvHelperTimeoutSeconds"
    },
    {
      "feature": "C",
      "key": "agentSecretEnvReservedPrefixes",
      "value": [
        "AWS_",
