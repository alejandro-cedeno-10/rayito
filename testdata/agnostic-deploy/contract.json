{
  "schema": "rayito.agnostic-deploy-contract/1",
  "_comment": "Contrato de integración de agnostic-agent-deploy (ADR-033 D1). Fija los nombres, tipos, valores por defecto y el punto de inserción de todo lo que cada función añade a un fichero o una superficie compartidos, para que las cuatro ramas se fusionen sin decisiones. `after` es el elemento existente (o de una función anterior en `mergeOrder`) tras el que va la adición. Los textos de ayuda son los de las dos CLI. Cada rama añade un test en cada SDK que compara su parte de este fichero con la superficie real (`testdata/cli/surface.json`, `__all__`/`index.ts`, `limits.json`).",
  "baseBranch": "feat/agnostic-deploy",
  "mergeOrder": [
    "A",
    "B",
    "C",
    "D"
  ],
  "features": {
    "A": {
      "change": "agent-model-optional",
      "branch": "feat/agent-model-optional",
      "adr": "ADR-033 D2",
      "vectors": [
        "testdata/agent-model-optional/requirement.json"
      ]
    },
    "B": {
      "change": "agent-structured-input",
      "branch": "feat/agent-structured-input",
      "adr": "ADR-033 D3",
      "vectors": [
        "testdata/agent-deploy/invocation-bodies.json"
      ]
    },
    "C": {
      "change": "agent-secret-env",
      "branch": "feat/agent-secret-env",
      "adr": "ADR-033 D4",
      "vectors": [
        "testdata/agent-secret-env/parse.json",
        "testdata/agent-secret-env/expand.json",
        "testdata/agent-secret-env/spec.json",
        "testdata/agent-secret-env/reserved.json"
      ]
    },
    "D": {
      "change": "agent-langgraph-api",
      "branch": "feat/agent-langgraph-api",
      "adr": "ADR-033 D5",
      "dependsOn": [
        "B"
      ],
      "vectors": [
        "testdata/agent-langgraph-api/requests.json",
        "testdata/agent-langgraph-api/responses.json"
      ]
    }
  },
