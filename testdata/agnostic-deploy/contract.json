  "tomlKeys": [
    {
      "feature": "A",
      "path": "model.id",
      "change": "required -> optional"
    },
    {
      "feature": "A",
      "path": "model.id_env",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "after": "model.prompt_caching"
    },
    {
      "feature": "A",
      "path": "model.base_url_env",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "after": "model.id_env"
    },
    {
      "feature": "A",
      "path": "model.api_key_env",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "after": "model.base_url_env"
    },
    {
      "feature": "B",
      "path": "runtime.graph",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "after": "runtime.adapter",
      "kinds": [
        "langgraph"
      ]
    },
    {
      "feature": "C",
      "path": "secret_env",
      "type": "table",
      "values": "string (secret name or ARN) | {secret, key?, version_stage?}",
      "propertyNames": "^[A-Za-z_][A-Za-z0-9_]*$",
      "after": "env"
    },
    {
      "feature": "C",
      "path": "secret_env_from",
      "type": "array of tables",
      "items": "{secret, prefix?, keys?}",
      "after": "secret_env"
    },
    {
      "feature": "D",
      "path": "runtime.app.protocol",
      "addsValue": "langgraph-api"
    },
    {
      "feature": "D",
      "path": "runtime.app.assistant_id",
      "type": "string",
      "requiredWhen": "protocol = langgraph-api",
      "after": "runtime.app.port_env"
    }
  ],
