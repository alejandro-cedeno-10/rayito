{
  "aws_env_credentials": {
    "python": "/opt/agents/rayito/aws-credentials/bin/python",
    "script": "/opt/agents/rayito/aws_env_credentials.py"
  },
  "driver": "node-callable",
  "limits": {
    "max_output_bytes": 16777216,
    "max_steps": 50,
    "max_total_tokens": 1000000,
    "timeout_seconds": 600
  },
  "max_concurrency": 1,
  "options": {
    "config_path": "/home/user/.rayito/agent/custom/config.json"
  },
  "queue_max": 0,
  "queue_timeout_seconds": 30,
  "schema": "rayito.agent-host/1",
  "session_header": "X-Amzn-Bedrock-AgentCore-Runtime-Session-Id",
  "v": 1
}
