{
  "description": "Vectores de los ARNs que el rol del runtime recibe para Bedrock (BedrockModelArns) y Secrets Manager (ReadableSecretArns). Un id con un prefijo de bedrockInferenceProfilePrefixes es un perfil de inferencia del sistema: su ARN en la región del modelo y el modelo base en cualquier región; un perfil global añade el ARN del modelo base sin región. Otro id es un modelo base en la región del modelo. Un ARN se usa tal cual. Se quitan duplicados conservando el orden. modelRegion es la región del modelo del proyecto o, sin ella, la del despliegue. Un valor que no es un nombre o id de su servicio (comodines, comas) o un ARN que no es de la partición, región y cuenta del despliegue (salvo el modelo base sin región o en cualquier región) es iam_resource_invalid: lo recogen `rejected` y los casos de plan-vectors.json.",
  "bedrock": [
    {
      "name": "perfil de inferencia us",
      "models": [
        "us.anthropic.claude-haiku-4-5-20251001-v1:0"
      ],
      "modelRegion": "us-east-1",
      "account": "123456789012",
      "partition": "aws",
      "expected": [
        "arn:aws:bedrock:us-east-1:123456789012:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0"
      ]
    },
    {
      "name": "perfil global",
      "models": [
        "global.anthropic.claude-haiku-4-5-20251001-v1:0"
      ],
      "modelRegion": "eu-west-1",
      "account": "123456789012",
      "partition": "aws",
      "expected": [
        "arn:aws:bedrock:eu-west-1:123456789012:inference-profile/global.anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0"
      ]
    },
    {
      "name": "modelo base regional",
      "models": [
        "amazon.nova-lite-v1:0"
      ],
      "modelRegion": "us-west-2",
      "account": "123456789012",
      "partition": "aws",
      "expected": [
        "arn:aws:bedrock:us-west-2::foundation-model/amazon.nova-lite-v1:0"
      ]
    },
    {
      "name": "ARN tal cual",
      "models": [
