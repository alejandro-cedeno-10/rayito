      ],
      "modelRegion": "us-east-1",
      "account": "123456789012",
      "partition": "aws",
      "expected": [
        "arn:aws:bedrock:us-east-1:123456789012:application-inference-profile/abc123"
      ]
    },
    {
      "name": "duplicados en orden",
