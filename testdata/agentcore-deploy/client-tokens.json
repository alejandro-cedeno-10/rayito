{
  "description": "El clientToken de CreateAgentRuntime y UpdateAgentRuntime (constants.clientTokenDigest): sha256 del JSON canónico de la petición de AWS sin clientToken y, al actualizar, con baseVersion, la agentRuntimeVersion que GetAgentRuntime dio justo antes. Una petición sin baseVersion es la de crear. Los dos SDK calculan el mismo token para cada caso.",
  "cases": [
    {
      "name": "create sin versión",
      "request": {
        "agentRuntimeName": "rayito_support_bot",
        "agentRuntimeArtifact": {
          "containerConfiguration": {
            "containerUri": "123456789012.dkr.ecr.us-east-1.amazonaws.com/rayito/agentcore/support-bot:src-0123456789abcdef"
          }
        },
        "roleArn": "arn:aws:iam::123456789012:role/rayito-agentcore-support-bot-runtime",
        "networkConfiguration": {
          "networkMode": "PUBLIC"
        },
        "protocolConfiguration": {
          "serverProtocol": "HTTP"
        },
        "lifecycleConfiguration": {
          "idleRuntimeSessionTimeout": 900,
          "maxLifetime": 28800
        },
        "environmentVariables": {
          "AWS_REGION": "us-east-1",
          "AWS_DEFAULT_REGION": "us-east-1"
        },
        "description": "Rayito agent support-bot (rayito.agentcore/1)",
        "tags": {
          "rayito:component": "agentcore-runtime"
        }
      },
      "expected": "rayito-daa620e01e0f776035ca60446a88e73a"
    },
