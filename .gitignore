# Rust
/target/
/target-*/
*.cdx.json

# Artefactos de imagen (se reconstruyen con `make image-zip`)
/image/rayd
/image/*.zip
/image/kernel-sidecar/

# Python
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.mypy_cache/
.venv/
/clients/python/dist/
/clients/python/build/
*.egg-info/

# TypeScript
node_modules/
/clients/typescript/dist/
/clients/typescript/coverage/
/clients/typescript/*.tgz
# Proyecto temporal de scripts/check_docs_examples.py --typescript
/clients/typescript/.docs-examples/

# Documentación generada
/docs/site/_build/
/site/

# Notas de trabajo del asistente y bitácoras de aceptación: son internas y no
# aportan nada al que clona el repositorio. Las skills del proyecto
# (`.claude/skills/`) sí se versionan: son las convenciones de ingeniería.
/.claude/*
!/.claude/skills/

# El spike de M0 ya no está en el árbol (historial de git), pero un clon
# antiguo puede conservar su salida cruda, que lleva IDs de cuenta, ARNs,
# endpoints e IDs de MicroVM del entorno donde se corrió: nunca se versiona.
/spike/

# Entorno local con Docker (make local-up): el contexto del guest se rehace en
# cada `make local-guest-context` y .cache guarda binarios y sondas locales.
/dev/local/.guest-context/
/dev/local/.cache/
